# Шаблон переменных окружения. Скопируйте в .env и подставьте реальные значения.
# Файл .env в .gitignore и в репозиторий НЕ попадает.

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=замените-на-случайный-длинный-ключ
DEBUG=False
# USE_SQLITE=True   # локально — SQLite; на проде не задавать (тогда PostgreSQL)

# PostgreSQL (нужно только если USE_SQLITE не задан)
DB_NAME=myproject_db
DB_USER=postgres
DB_PASSWORD=пароль-БД

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── iiko ──────────────────────────────────────────────────────────────────────
IIKO_CLOUD_API_KEY=apiLogin-из-iikoweb
IIKO_ORG_ID=uuid-организации
IIKO_EXTERNAL_MENU_ID=id-внешнего-меню
IIKO_APP_ID=appId-из-кабинета-разработчика
IIKO_CLIENT_SECRET=clientSecret-из-кабинета-разработчика
IIKO_SERVER_URL=https://ваш-сервер.iiko.it/resto
IIKO_SERVER_LOGIN=логин-iiko-server
IIKO_SERVER_PASSWORD=пароль-iiko-server
